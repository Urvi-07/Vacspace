<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vacspace_background">

    <!-- Subtle background detail -->
    <View
        android:id="@+id/decorativeCircle"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.10"
        android:background="@drawable/bg_splash_circle"
        android:translationX="125dp"
        android:translationY="-125dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Brand statement -->
    <TextView
        android:id="@+id/tvTopLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="38dp"
        android:letterSpacing="0.22"
        android:text="COMMERCIAL&#10;SPACES&#10;REIMAGINED"
        android:textColor="@color/vacspace_text_secondary"
        android:textSize="8sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Teal accent -->
    <View
        android:id="@+id/topAccent"
        android:layout_width="38dp"
        android:layout_height="3dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:background="@color/vacspace_accent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTopLabel" />

    <!-- Approved Vacspace logo -->
    <ImageView
        android:id="@+id/ivVacspaceLogo"
        android:layout_width="310dp"
        android:layout_height="250dp"
        android:layout_marginTop="100dp"
        android:contentDescription="Vacspace logo"
        android:scaleType="fitCenter"
        android:src="@drawable/img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAccent" />

    <!-- Bottom message -->
    <TextView
        android:id="@+id/tvBottomMessage"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="34dp"
        android:gravity="center"
        android:text="Empty spaces.&#10;Brighter possibilities."
        android:textColor="@color/vacspace_text_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/progressFirst"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Active progress -->
    <View
        android:id="@+id/progressFirst"
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_progress_active"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/progressSecond" />

    <!-- Inactive progress -->
    <View
        android:id="@+id/progressSecond"
        android:layout_width="18dp"
        android:layout_height="4dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_progress_inactive"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/progressThird" />

    <!-- Inactive progress -->
    <View
        android:id="@+id/progressThird"
        android:layout_width="8dp"
        android:layout_height="4dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_progress_inactive"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>